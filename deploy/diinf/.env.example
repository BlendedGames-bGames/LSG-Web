# LifeSync-Games Auth and Vitrina

# --- Base URL ---
BASE_URL=https://vitrina.diinf.usach.cl

# --- MongoDB Atlas (shared by Auth and Vitrina) ---
MONGODB_URI=mongodb+srv://......

# --- JWT (SHARED platform-wide: Auth, Vitrina AND Cloud, must be identical) ---
JWT_SECRET=

# --- Auth Service ---
ENCRYPTION_KEY=
AUTH_PROVIDER=firebase
# Firebase Admin SDK credentials (from the service account key, no file checked in)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escape sequences literal (single line); the app restores real newlines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
INTERNAL_SERVICES=vitrina
VITRINA_API_KEY=apikey1
CORS_ORIGINS=https://vitrina.diinf.usach.cl
ALLOWED_REDIRECT_ORIGINS=https://vitrina.diinf.usach.cl

# OAuth GitLab
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# OAuth GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Vitrina API ---
AUTH_SERVICE_API_KEY=apikey1
REQUIRE_REPO_OWNERSHIP_CHECK=false
MODERATION_AUTO_SUSPEND=false
MODERATION_UNSAFE_THRESHOLD=0.5
MODERATION_REVIEWERS_PER_PUB=5
# Email settings for moderation notifications
RESEND_API_KEY=
EMAIL_FROM="LifeSync-Games <onboarding@resend.dev>"

# --- Firebase (baked at build time for frontend) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Cloud Module (MySQL 8, local container) ---
CLOUD_MYSQL_ROOT_PASSWORD=
CLOUD_MYSQL_DATABASE=bgames
