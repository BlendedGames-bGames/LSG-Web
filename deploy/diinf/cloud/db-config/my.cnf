# ============================================
# MySQL 8.0 — Memory-optimized config for 2GB VPS
# ============================================
# Target: ~150-200MB total MySQL memory footprint
# (default MySQL 8.0 uses 400-600MB)

[mysqld]
# --- Buffer Pool ---
# Default: 128MB. Reduced to 32MB — sufficient for small dataset (~15 tables)
innodb_buffer_pool_size=32M

# --- Log Buffer ---
# Default: 16MB. Reduced — small transaction workload
innodb_log_buffer_size=4M

# --- Redo Log ---
# Smaller redo logs (default 48MB each, 2 files = 96MB)
innodb_redo_log_capacity=32M

# --- Sort/Join Buffers ---
# Per-connection buffers — keep small since few concurrent queries
sort_buffer_size=256K
join_buffer_size=256K
read_buffer_size=128K
read_rnd_buffer_size=256K

# --- Connections ---
# Only 5 microservices connect, each with 1-2 connections
max_connections=20
thread_cache_size=4

# --- Performance Schema ---
# Disable to save ~100MB of RAM (not needed for production workload)
performance_schema=OFF

# --- Temp Tables ---
# Reduce in-memory temp table limits
tmp_table_size=8M
max_heap_table_size=8M

# --- Binary Logging ---
# Disable binlog — not needed for single-instance deployment (no replication)
skip-log-bin

# --- Table Cache ---
# Small dataset, ~15 tables
table_open_cache=64
table_definition_cache=64

# --- Misc ---
# Use native password plugin (required by node mysql driver)
default-authentication-plugin=mysql_native_password
